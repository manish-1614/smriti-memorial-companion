rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for unmatched collections to uphold Zero Insecure Defaults
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated users only have access to their own data tree under /users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Memorial profiles for this user
      match /memorials/{memorialId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Memories collection under specific memorial
        match /memories/{memoryId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Chat sessions and messages under specific memorial
        match /conversations/{conversationId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;

          match /messages/{messageId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;
          }
        }

        // Dedicated sessions collection support
        match /sessions/{sessionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;

          match /messages/{messageId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;
          }
        }
      }
    }
  }
}
